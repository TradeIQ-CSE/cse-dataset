!data/raw/**/
!data/raw/.gitkeep
!data/raw/**/.gitkeep
!data/processed/
!data/processed/**/
!data/processed/.gitkeep
!data/processed/**/.gitkeep
!data/published/
!data/published/**/
!data/published/.gitkeep
!data/published/**/.gitkeep

