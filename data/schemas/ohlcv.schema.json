{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical CSE OHLCV Row",
  "type": "object",
  "required": [
    "date",
    "symbol",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "turnover",
    "trades",
    "source",
    "source_priority",
    "source_timestamp",
    "raw_payload_hash",
    "validation_status",
    "validation_warnings"
  ],
  "properties": {
    "date": {"type": "string", "format": "date"},
    "symbol": {"type": "string", "minLength": 1},
    "open": {"type": "number"},
    "high": {"type": "number"},
    "low": {"type": "number"},
    "close": {"type": "number"},
    "volume": {"type": "number", "minimum": 0},
    "turnover": {"type": "number", "minimum": 0},
    "trades": {"type": "number", "minimum": 0},
    "source": {"type": "string", "minLength": 1},
    "source_priority": {"type": "integer"},
    "source_timestamp": {"type": "string", "format": "date"},
    "raw_payload_hash": {"type": "string", "minLength": 64, "maxLength": 64},
    "validation_status": {"type": "string"},
    "validation_warnings": {"type": "string"},
    "source_open": {"type": ["number", "null"]},
    "source_high": {"type": ["number", "null"]},
    "source_low": {"type": ["number", "null"]},
    "source_close": {"type": ["number", "null"]},
    "source_ohlc_invalid": {"type": "boolean"},
    "ohlc_repaired": {"type": "boolean"},
    "ohlc_invalid": {"type": "boolean"}
  },
  "additionalProperties": true
}
